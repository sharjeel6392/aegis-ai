# --- APP ---
AEGIS_ENV=local
AEGIS_LOG_LEVEL=INFO
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000

# --- Postgres ---
# Async driver on purpose: SQLAlchemy 2.0 async engine + asyncpg.
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis

# Consumed by the postgres container itself, not by the app.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# --- Redis / arq ---
AEGIS_REDIS_URL=redis://redis:6379/0